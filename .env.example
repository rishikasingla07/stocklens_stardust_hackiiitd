# Copy to .env and fill in. Never commit .env.
# STOCKLENS_MODE: live | replay
STOCKLENS_MODE=replay
TINYFISH_API_KEY=
LLM_API_KEY=
STOCKLENS_DB_PATH=stocklens.db
# LLM_PROVIDER: anthropic | openai | gemini
LLM_PROVIDER=anthropic
# Leave empty for the provider default (anthropic only); required for openai and gemini.
LLM_MODEL=
